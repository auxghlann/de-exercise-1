cells:
  - kind: 1
    languageId: markdown
    value: "# Experiment and Explore"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT *\r

      FROM bronze_job_applications\r

      LIMIT 10;"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT COUNT(*) as row_count\r

      FROM bronze_job_applications;"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "## Possible Next Approach\r

      \r

      - Remove unusable table (e.g., `notes` column)\r

      - fix table datatypes\r

      - clean table (fill NA)\r

      - normalize table"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "## Fix table Datatypes"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT column_name, data_type\r

      FROM information_schema.columns\r

      WHERE table_name = 'bronze_job_applications'\r

      ORDER BY column_name;"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "As you can see almost all of the data types of the columns are `text`.
      Even the dates!\r

      \r

      Cast the dates to `date` before normalizing the table"
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "### Normalize Table\r\n\r\n- "
    metadata: {}

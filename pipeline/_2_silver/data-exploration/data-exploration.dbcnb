  - kind: 1
    languageId: markdown
    value: "## Missing Check"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT\r

      \    COUNT(*) - COUNT(applicant_name) as applicant_name_count,\r

      \    COUNT(*) - COUNT(application_id) as application_id_count,\r

      \    COUNT(*) - COUNT(application_date) as application_date_count,\r

      \    COUNT(*) - COUNT(company) as company_count,\r

      \    COUNT(*) - COUNT(email) as email_count,\r

      \    COUNT(*) - COUNT(industry) as industry_count,\r

      \    COUNT(*) - COUNT(interview_date) as interview_date_count,\r

      \    COUNT(*) - COUNT(job_title) as job_title_count,\r

      \    COUNT(*) - COUNT(location) as location_count,\r

      \    COUNT(*) - COUNT(salary_expected) as salary_expected_count,\r

      \    COUNT(*) - COUNT(source) as source_count,\r

      \    COUNT(*) - COUNT(stage) as stage_count,\r

      \    COUNT(*) - COUNT(recruiter) as recruiter_count\r

      FROM bronze_job_applications; "
    metadata: {}
  - kind: 1
    languageId: markdown
    value: "The table yields a few missing on columns:\r

      - `application_date_count` : 3\r

      - `interview_date_count` : 37\r

      - `salary_expected_count` : 5\r

      - `recruiter_count` : 6\r

      \r

      > *Note to future self: The current query is **not scalable**. Try to find
      or research about optimized null counts query*"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT \r

      \    s.attname AS column_name,\r

      \    ROUND((s.null_frac * c.reltuples)::numeric) AS
      estimated_null_count,\r

      \    ROUND((s.null_frac * 100)::numeric, 2) AS null_percentage\r

      FROM pg_stats s\r

      JOIN pg_class c ON c.relname = s.tablename\r

      JOIN pg_namespace n ON n.oid = c.relnamespace AND n.nspname =
      s.schemaname\r

      WHERE s.tablename = 'bronze_job_applications' \r

      \  AND s.schemaname = 'public';"
